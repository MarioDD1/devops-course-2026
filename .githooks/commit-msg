#!/bin/sh
first_line=$(head -n 1 "$1")
if ! printf "%s\n" "$first_line" | grep -Eq "^(feat|fix|docs|chore|refactor|merge|test|ci|build|perf|style)(\([[:alnum:]_./-]+\))?!?: .+"; then
  echo "ERROR: commit message must follow Conventional Commits." >&2
  echo "Expected: <type>: <description>" >&2
  exit 1
fi
